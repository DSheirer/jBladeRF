# Pinned native sources for jBladeRF releases. Sourced by the build scripts and
# read by the GitHub workflows. To move to a new upstream release, change these
# values and open a pull request.
#
# BLADERF_REF is the upstream tag to build. Upstream's yearly release tags, such
# as 2025.10, are newer than its libbladeRF_v* tags, so BLADERF_VERSION records
# the libbladeRF version the tag contains. It is also the jBladeRF version, and
# the build fails if it does not match the sources.
BLADERF_REPOSITORY=https://github.com/Nuand/bladeRF.git
BLADERF_REF=2025.10
BLADERF_VERSION=2.6.0
LIBUSB_VERSION=1.0.30
LIBUSB_TARBALL_SHA256=fea36f34f9156400209595e300840767ab1a385ede1dc7ee893015aea9c6dbaf
LIBUSB_WINDOWS_7Z_SHA256=7fb1dfec805b97983763d7d0ae244320da12add1003d4249c96cc4d586398c79
